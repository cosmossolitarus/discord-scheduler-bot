# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

DISCORD_BOT_TOKEN=your_discord_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DATABASE_URL is set automatically by Railway in production.
# For local development, leave this unset to use SQLite.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scheduler
